# Local demo
AUTH_SECRET=generate-a-long-random-string
DEV_AUTH=true
# Station (folder scrivengroup) uses :3000. A wip desk must change this to its own port (:3001, :3002, …).
AUTH_URL=http://localhost:3000
# WIP desk only (e.g. wip-hub). Yellow badge in chrome. Station and Azure omit this.
# WIP_DESK=wip-hub

# Neon (optional locally; required on Azure when using Postgres store)
# DATABASE_URL=postgresql://...
# Also write JSON files while DATABASE_URL is set (one local run, then off):
# SIMPLE_STORE_DUAL_WRITE=1

# Entra (enable Microsoft login locally + Azure)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Azure production
# AUTH_URL=https://app-scrivengroup-….azurewebsites.net
# DEV_AUTH=false

# Shared MRT view is managed in-app (Admin → Sharing). Do not set a portal password.
# MRT_SHARE_PASSWORD=
# Guest sandbox TTL (unused while guests are read-only; helpers remain).
# MRT_SANDBOX_TTL_HOURS=168
