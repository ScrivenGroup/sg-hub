# Local demo
AUTH_SECRET=generate-a-long-random-string
DEV_AUTH=true
AUTH_URL=http://localhost:3000

# Neon (optional locally; required on Azure when using Postgres store)
# DATABASE_URL=postgresql://...

# Entra (enable Microsoft login locally + Azure)
# AUTH_MICROSOFT_ENTRA_ID_ID=
# AUTH_MICROSOFT_ENTRA_ID_SECRET=
# AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0

# Azure production
# AUTH_URL=https://app-scrivengroup-….azurewebsites.net
# DEV_AUTH=false

# Shared MRT view is managed in-app (Admin → Sharing). Do not set a portal password.
# MRT_SHARE_PASSWORD=
# Guest sandbox TTL (unused while guests are read-only; helpers remain).
# MRT_SANDBOX_TTL_HOURS=168
